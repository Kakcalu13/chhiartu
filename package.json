{
  "name": "github-md-viewer",
  "version": "1.0.0",
  "description": "A premium desktop Markdown documentation reader for macOS",
  "main": "main.js",
  "author": "kaknockout3",
  "license": "MIT",
  "scripts": {
    "vendor": "node scripts/copy-vendor.js",
    "icon": "node scripts/make-icon.js",
    "test": "node scripts/test-render.js",
    "start": "npm run vendor && electron .",
    "dist": "npm run vendor && npm run icon && electron-builder --mac"
  },
  "build": {
    "appId": "com.kaknockout3.mdviewer",
    "productName": "Markdown Viewer",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "vendor/**/*",
      "!samples/**/*",
      "!scripts/**/*"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd",
          "mdx",
          "markdn"
        ],
        "name": "Markdown Document",
        "role": "Viewer",
        "icon": "build/icon.icns"
      },
      {
        "ext": [
          "txt",
          "text"
        ],
        "name": "Plain Text Document",
        "role": "Viewer",
        "icon": "build/icon.icns"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "icon": "build/icon.icns"
    }
  },
  "devDependencies": {
    "dompurify": "^3.2.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "mermaid": "^11.4.1",
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "katex": "^0.16.47",
    "marked": "^15.0.6",
    "marked-gfm-heading-id": "^4.1.1",
    "marked-highlight": "^2.2.1"
  }
}
